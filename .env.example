# Tagery – ukázkové proměnné prostředí (zkopíruj do .env)

# --- Obecné ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=3001
# PostgreSQL (v produkci Neon/Supabase; lokálně Docker Compose)
DATABASE_URL=postgres://tagery:tagery@localhost:5432/tagery
# Redis (v produkci Upstash; lokálně Docker Compose)
REDIS_URL=redis://localhost:6379
# Úložiště médií (ADR-0008): local | r2 | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
