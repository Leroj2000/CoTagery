# Tagery – ukázkové proměnné prostředí (zkopíruj do .env)

# --- Obecné ---
NODE_ENV=development

# --- API (apps/api) ---
API_PORT=3001
# PostgreSQL – migrace/seed běží pod vlastníkem (superuser)
DATABASE_URL=postgres://tagery:tagery@localhost:5432/tagery
# Runtime spojení aplikace = ne-superuser role podléhající RLS (ADR-0001)
APP_DATABASE_URL=postgres://tagery_app:tagery_app@localhost:5432/tagery
# Redis (v produkci Upstash; lokálně Docker Compose)
REDIS_URL=redis://localhost:6379
# Úložiště médií (ADR-0008): local | r2 | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.storage
# Auth (EPIC-01) – JWT. Secret v produkci ze secret manageru!
JWT_SECRET=dev-secret-change-me-min-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
